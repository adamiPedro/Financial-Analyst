root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,html,css,js}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.cs]
# Usings
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# File-scoped namespaces
csharp_style_namespace_declarations = file_scoped:warning

# var
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Modern C#
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_braces = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion

# Naming: private fields _camelCase
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix.required_prefix = _
dotnet_naming_style.underscore_prefix.capitalization = camel_case

# Async methods must be awaited somewhere
dotnet_diagnostic.CS4014.severity = error

[tests/**.cs]
# Sentence-style test names (Name_is_required) are the xUnit convention and read
# as the test description in the runner. CA1707 guards public library APIs, not
# test methods.
dotnet_diagnostic.CA1707.severity = none

[src/FinancialIntelligence.Infrastructure/Migrations/*.cs]
# Written by `dotnet ef migrations add`, not by hand. The Designer and snapshot
# files carry <auto-generated />, the migration itself does not, so without this
# the repo's style rules (file-scoped namespaces, etc.) fail the build on tool
# output.
generated_code = true
