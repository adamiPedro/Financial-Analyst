<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\FinancialIntelligence.Application\FinancialIntelligence.Application.csproj" />
    <!--
      Api -> Infrastructure exists ONLY so Program.cs can register concrete
      implementations (the composition root). No Infrastructure type may be
      used anywhere else in this project. See the note in Program.cs.
    -->
    <ProjectReference Include="..\FinancialIntelligence.Infrastructure\FinancialIntelligence.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Npgsql" />
    <!--
      Design-time only, for `dotnet ef`. The tools load it from the startup
      project, not from the project holding the DbContext, so it has to live
      here. No code in Api uses it.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
