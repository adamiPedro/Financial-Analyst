# Copy to .env for local overrides. .env is gitignored; this file is not.
# Defaults in docker-compose.yml match these, so .env is optional.

POSTGRES_DB=findb
POSTGRES_USER=findb
POSTGRES_PASSWORD=findb

# Provider API keys do NOT go here. Use dotnet user-secrets:
#   dotnet user-secrets set "Providers:TwelveData:ApiKey" "<key>" \
#     --project src/FinancialIntelligence.Api
