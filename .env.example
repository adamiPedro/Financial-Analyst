# Copy to .env for local overrides. .env is gitignored; this file is not.
# Defaults in docker-compose.yml match these, so .env is optional.

POSTGRES_DB=findb
POSTGRES_USER=findb
POSTGRES_PASSWORD=findb

# The data path needs no keys. The only secret in the project is the dev-time
# cloud AI key (ADR 0006), and it does NOT go here. Use dotnet user-secrets:
#   dotnet user-secrets set "AI:Cloud:ApiKey" "<key>" \
#     --project src/FinancialIntelligence.Api
